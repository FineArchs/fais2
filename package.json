{
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"playground"
	],
	"name": "@finearchs/faiscript",
	"version": "0.0.0",
	"description": "An AiScript Fork by FineArchs",
	"author": "FineArchs",
	"license": "MIT",
	"exports": {
		".": "./built/index.js",
		"./*": "./built/*"
	},
	"scripts": {
		"start": "bun ./scripts/exec.ts",
		"build": "bun scripts/gen-pkg-ts.ts && tsc",
		"typecheck": "bun run build && tsc --project tsconfig.test.json && tsc --project tsconfig.scripts.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^9.32.0",
		"@types/bun": "^1.4.2",
		"@types/seedrandom": "^3.0.8",
		"chalk": "^5.5.0",
		"eslint": "^9.32.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-unused-imports": "^4.2.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"seedrandom": "^3.0.5",
		"stringz": "^2.1.0",
		"uuid": "^14.0.2"
	}
}
