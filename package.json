		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-unused-imports": "^4.2.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"seedrandom": "^3.0.5",
